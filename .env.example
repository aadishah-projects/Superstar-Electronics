# Phase 1 portal development settings
# Keep the real values in .env.local and never commit that file.
PORTAL_BOOTSTRAP_EMAIL=suvashshah251@gmail.com
PORTAL_BOOTSTRAP_KEY=replace-with-a-long-random-local-key
PORTAL_SESSION_TTL_DAYS=7
PORTAL_AUTH_BACKEND=sqlite
NEXT_PUBLIC_PORTAL_AUTH_BACKEND=sqlite

# Set this to a secure random value before any shared/staging deployment.
# Production persistence will require a managed database and private object storage.
PORTAL_ENVIRONMENT=development
PORTAL_DATABASE_PATH=data/portal.sqlite
# Keep SQLite while the Firestore repositories are being migrated and reviewed.
# Switch to firestore only after the portal workflows have been migrated.
PORTAL_DATA_BACKEND=sqlite
# Keep the public catalog on its existing static source until a staging migration is reviewed.
PORTAL_CATALOG_SOURCE=static
PORTAL_VAT_RATE=13
PORTAL_QUOTATION_VALIDITY_DAYS=3
PORTAL_WARRANTY_MONTHS=12
PORTAL_WHATSAPP_NUMBER=9779855026835

# Notifications currently stay inside the portal. Add a provider only after
# the business selects an SMS or official WhatsApp service.
PORTAL_NOTIFICATION_MODE=in-app
PORTAL_EMAIL_MODE=disabled
PORTAL_EMAIL_FROM=Super Star Electronics <noreply@example.com>
PORTAL_EMAIL_API_KEY=replace-with-server-side-provider-key
PORTAL_ATTACHMENT_STORAGE=r2

# Firebase Admin SDK. Keep these server-only and never commit the downloaded
# service-account JSON file.
FIREBASE_PROJECT_ID=super-star-electronics-portal
FIREBASE_CLIENT_EMAIL=replace-with-firebase-service-account-email
FIREBASE_PRIVATE_KEY=replace-with-firebase-private-key

# Firebase Web SDK configuration. These values are public client configuration,
# but should still be supplied through the deployment environment.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=super-star-electronics-portal.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=super-star-electronics-portal
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=super-star-electronics-portal.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-app-id

# Private Cloudflare R2 object storage.
CLOUDFLARE_R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET_NAME=superstarelectronics
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# Dedicated private R2 storage for public customer review photos.
# The existing unsuffixed R2 variables above remain reserved for portal files.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
REVIEW_R2_BUCKET_NAME=superstar-review-photos
R2_ACCESS_KEY_ID_2=replace-with-review-r2-access-key-id
R2_SECRET_ACCESS_KEY_2=replace-with-review-r2-secret-access-key
